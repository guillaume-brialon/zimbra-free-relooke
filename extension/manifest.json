{
  "manifest_version": 3,
  "name": "Relooking pour le Zimbra de Free",
  "short_name": "Relooking Zimbra",
  "version": "1.0.0",
  "author": "Guillaume Brialon",
  "homepage_url": "https://brialon.com",
  "description": "Modernise l'apparence du webmail Zimbra de Free (zimbra.free.fr, thème Simple) : couleurs, typographie, icônes, espacements. Extension non officielle, sans lien avec Free ni Zimbra.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://zimbra.free.fr/zimbra/*"],
      "exclude_matches": [
        "*://zimbra.free.fr/zimbra/h/*",
        "*://zimbra.free.fr/zimbra/m/*"
      ],
      "run_at": "document_start",
      "css": [
        "css/fonts.css",
        "css/tokens.css",
        "css/base.css",
        "css/layout.css",
        "css/widgets.css",
        "css/icons.css",
        "css/search.css",
        "css/mail.css",
        "css/contacts.css",
        "css/calendar.css",
        "css/prefs.css"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://zimbra.free.fr/*"]
    }
  ],
  "action": {
    "default_title": "Relooking pour le Zimbra de Free",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zimbra-free-relooke@brialon.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
